# -----------------------------------------------------------------------------
# Pega Constellation Starter - environment configuration
# Copy to `.env` (git-ignored) and fill in values for YOUR Pega instance.
# NOTE: every VITE_* variable is embedded into the browser bundle. Only use
# credentials intended for a public / dev OAuth client, never production secrets.
# -----------------------------------------------------------------------------

# Base URL of your Pega Infinity / Pega Cloud instance, including the context root
VITE_PEGA_BASE_URL=https://your-pega-host.example.com/prweb
# true = route API calls through the Vite dev-server proxy (avoids CORS locally)
VITE_PEGA_DEV_PROXY=false
VITE_PEGA_APP_ALIAS=your-app-alias
VITE_PEGA_CUSTOMER_ID_PARAM=CustomerID

# OAuth 2.0 client registration used for portal login (Dev Studio > Records > Security > OAuth 2.0 Client Registration)
VITE_PEGA_CLIENT_ID=
VITE_PEGA_CLIENT_SECRET=
VITE_PEGA_GRANT_TYPE=client_credentials
VITE_PEGA_AUTHORIZATION_URL=
VITE_PEGA_TOKEN_URL=
VITE_PEGA_REVOKE_URL=
VITE_PEGA_JWKS_URL=
VITE_PEGA_INTROSPECT_URL=

# Optional: separate OAuth client for DX API calls (falls back to the values above)
VITE_PEGA_API_CLIENT_ID=
VITE_PEGA_API_CLIENT_SECRET=
VITE_PEGA_API_GRANT_TYPE=client_credentials
VITE_PEGA_API_AUTHORIZATION_URL=
VITE_PEGA_API_TOKEN_URL=
VITE_PEGA_API_REVOKE_URL=
VITE_PEGA_API_JWKS_URL=
VITE_PEGA_API_INTROSPECT_URL=

# Optional: OAuth client used by the Constellation SDK (sdk-config.json is generated
# from these in dev when no local sdk-config.json exists; defaults to VITE_PEGA_CLIENT_*)
VITE_PEGA_SDK_CLIENT_ID=
VITE_PEGA_SDK_CLIENT_SECRET=

# Optional: only for local testing with the password grant - never commit real values
VITE_PEGA_USERNAME=
VITE_PEGA_PASSWORD=

# Data views (D_ pages) that feed the dashboard lists
VITE_PEGA_POLICY_DATA_VIEW_ID=D_CustomerPoliciesList
VITE_PEGA_CLAIMS_DATA_VIEW_ID=D_CustomerClaimsList
VITE_PEGA_SERVICE_TASKS_DATA_VIEW_ID=
VITE_PEGA_DASHBOARD_DATA_VIEW_ID=D_CustomerDashboardList

# Case type IDs in your Pega application (examples follow an "IH-Insure-Work-*" sample app)
VITE_PEGA_CLAIM_CASE_TYPE_ID=IH-Insure-Work-HealthClaims
VITE_PEGA_HEALTH_CLAIM_CASE_TYPE_ID=IH-Insure-Work-HealthClaims
VITE_PEGA_MOTOR_CLAIM_CASE_TYPE_ID=IH-Insure-Work-MotorClaims
VITE_PEGA_COMPLAINT_CASE_TYPE_ID=IH-Insure-Work-Complaint
VITE_PEGA_MANUAL_TRIAGE_CASE_TYPE_ID=IH-Insure-Work-ManualTriage
VITE_PEGA_SERVICE_CASE_TYPE_ID=IH-Insure-Work-ServiceRequest
VITE_PEGA_CHANGE_ADDRESS_CASE_TYPE_ID=IH-Insure-Work-ChangeAddress
VITE_PEGA_CHANGE_CONTACT_CASE_TYPE_ID=IH-Insure-Work-ChangeContactDetails
VITE_PEGA_POLICY_CHANGE_CASE_TYPE_ID=IH-Insure-Work-PolicyClarification
VITE_PEGA_SCHEDULE_CONSULTATION_CASE_TYPE_ID=IH-Insure-Work-ScheduleConsultation

# Policy AI chat: Pega AI agent ID used by the in-portal chat (see src/components/PolicyAIChat.tsx)
VITE_PEGA_POLICY_AGENT_ID=IH-INSURE-WORK-POLICYCLARIFICATION!POLICYQUESTION
